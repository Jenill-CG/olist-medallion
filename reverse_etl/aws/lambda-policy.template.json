{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCallLists",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__BUCKET__/queue/*"
    },
    {
      "Sid": "ReadWriteReceipts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/receipts/*"
    },
    {
      "Sid": "ListBucketSoMissingReceiptIs404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "ReadOlistParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-south-1:__ACCOUNT_ID__:parameter/olist/*"
    },
    {
      "Sid": "DecryptSecureStringsViaSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.ap-south-1.amazonaws.com" } }
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-south-1:__ACCOUNT_ID__:log-group:/aws/lambda/olist-trigger-calls:*"
    }
  ]
}
