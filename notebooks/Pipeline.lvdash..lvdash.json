{
  "datasets": [
    {
      "name": "9311367b",
      "displayName": "kpis",
      "queryLines": [
        "SELECT sum(price)                                   AS revenue,\r\n",
        "       count(DISTINCT order_id)                     AS orders,\r\n",
        "       sum(price) / count(DISTINCT order_id)        AS avg_order_value,\r\n",
        "       avg(review_score)                            AS avg_review,\r\n",
        "       avg(CASE WHEN is_late THEN 1.0 ELSE 0.0 END)\r\n",
        "           FILTER (WHERE delivered_at IS NOT NULL)  AS late_share\r\n",
        "FROM olist.gold.fact_sales;\r\n"
      ]
    },
    {
      "name": "18a0f7ad",
      "displayName": "monthly_sales",
      "queryLines": [
        "SELECT to_date(year_month || '-01') AS month,\r\n",
        "       sum(orders)                  AS orders,\r\n",
        "       sum(revenue)                 AS revenue\r\n",
        "FROM olist.gold.agg_daily_sales\r\n",
        "GROUP BY year_month\r\n",
        "ORDER BY month"
      ]
    },
    {
      "name": "6a1a5fb2",
      "displayName": "top_categories",
      "queryLines": [
        "SELECT category, revenue, orders, round(avg_review_score, 2) AS avg_review\r\n",
        "FROM olist.gold.agg_category_sales\r\n",
        "ORDER BY revenue DESC\r\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "96b65539",
      "displayName": "state_sales",
      "queryLines": [
        "SELECT state_code, state_name, region, orders, revenue,\r\n",
        "       round(avg_delivery_days, 1)  AS avg_delivery_days,\r\n",
        "       round(late_share * 100, 1)   AS late_pct\r\n",
        "FROM olist.gold.agg_state_sales\r\n",
        "ORDER BY revenue DESC"
      ]
    },
    {
      "name": "c3ae2715",
      "displayName": "order_status",
      "queryLines": [
        "SELECT order_status, count(DISTINCT order_id) AS orders\r\n",
        "FROM olist.gold.fact_sales\r\n",
        "GROUP BY order_status\r\n",
        "ORDER BY orders DESC"
      ]
    },
    {
      "name": "caa9d77a",
      "displayName": "freshness",
      "queryLines": [
        "SELECT\r\n",
        "latest_source_change,\r\n",
        "date_format(from_utc_timestamp(gold_loaded_at, 'Asia/Kolkata'), 'dd MMM yyyy, hh:mm a') || ' IST' AS gold_loaded_at_ist,\r\n",
        "lag_minutes\r\n",
        "FROM olist.ops.pipeline_freshness"
      ]
    }
  ],
